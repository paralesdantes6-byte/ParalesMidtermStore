@model IEnumerable<ParalesMidtermStore.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container">
    <h1>Products</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>₱@item.Price</td>
                    <td>@item.Category</td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger">
                            Delete
                        </a>

                        <a asp-controller="Cart"
                           asp-action="AddToCart"
                           asp-route-id="@item.Id"
                           class="btn btn-success">
                            Add to Cart
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>