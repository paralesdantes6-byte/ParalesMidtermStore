@model List<ParalesMidtermStore.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<h1>Cart</h1>

@if (Model.Count == 0)
{
    <p>Your cart is empty.</p>

    <a asp-controller="Products" asp-action="Index">
        Back to Products
    </a>
}
else
{
    <table border="1" cellpadding="8">
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
            <th>Action</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>₱@item.Price</td>

                <td>
                    <form asp-action="UpdateQuantity" method="post">
                        <input type="hidden"
                               name="id"
                               value="@item.Id" />

                        <input type="number"
                               name="quantity"
                               value="@item.Quantity"
                               min="1"
                               style="width:50px;" />

                        <button type="submit">
                            Update
                        </button>
                    </form>
                </td>

                <td>
                    ₱@(item.Price * item.Quantity)
                </td>

                <td>
                    <a asp-action="Remove"
                       asp-route-id="@item.Id">
                        Remove
                    </a>
                </td>
            </tr>
        }
    </table>

    <h3>
        Total: ₱@Model.Sum(x => x.Price * x.Quantity)
    </h3>

    <a asp-controller="Products" asp-action="Index">
        Continue Shopping
    </a>
}