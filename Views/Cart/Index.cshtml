@model List<ParalesMidtermStore.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h1>Shopping Cart</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Your cart is empty.
    </div>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-primary">
        Continue Shopping
    </a>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>

                    <td>₱@item.Price</td>

                    <td>
                        <form asp-action="UpdateQuantity"
                              method="post"
                              class="d-flex">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control"
                                   style="width: 90px;" />

                            <button type="submit"
                                    class="btn btn-warning ms-2">
                                Update
                            </button>
                        </form>
                    </td>

                    <td>
                        ₱@(item.Price * item.Quantity)
                    </td>

                    <td>
                        <a asp-action="Remove"
                           asp-route-id="@item.Id"
                           class="btn btn-danger"
                           onclick="return confirm('Remove this item?')">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="text-end">
        Total:
        ₱@Model.Sum(item => item.Price * item.Quantity)
    </h3>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-secondary">
        Continue Shopping
    </a>
}